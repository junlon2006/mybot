# Test-only preload cache for source and installed-package integration fixtures.
set(CONFIG_PLATFORM "@CONFIG_PLATFORM@" CACHE STRING "" FORCE)
set(CMAKE_C_COMPILER "@CMAKE_C_COMPILER@" CACHE FILEPATH "" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "" FORCE)
set(AOSL_DIR "@AOSL_DIR@" CACHE PATH "" FORCE)
set(AGORA_SDK_DIR "@AGORA_SDK_DIR@" CACHE PATH "" FORCE)
set(AGORA_RTC_LIBRARY "@AGORA_RTC_LIBRARY@" CACHE FILEPATH "" FORCE)
set(MYBOT_AGORA_SDK_DIR "@AGORA_SDK_DIR@" CACHE PATH "" FORCE)
set(MYBOT_AGORA_RTC_LIBRARY "@AGORA_RTC_LIBRARY@" CACHE FILEPATH "" FORCE)
set(MYBOT_TEST_CONFIG_DIR "@MYBOT_TEST_CONFIG_DIR@" CACHE PATH "" FORCE)
# The fixtures exercise feature propagation independently of instrumentation.
set(MYBOT_ENABLE_ASAN OFF CACHE BOOL "" FORCE)
set(MYBOT_ENABLE_UBSAN OFF CACHE BOOL "" FORCE)
set(MYBOT_ENABLE_COVERAGE OFF CACHE BOOL "" FORCE)
